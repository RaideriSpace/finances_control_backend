DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=

# Origens permitidas por CORS, separadas por vírgula. Default: http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000

# "true" exige validação estrita do certificado TLS do Postgres.
# Default (false) preserva o comportamento atual, necessário para o
# pooler gerenciado usado em produção.
DB_SSL_REJECT_UNAUTHORIZED=false

PORT=3000
